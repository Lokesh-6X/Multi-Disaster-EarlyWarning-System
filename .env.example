# Copy to .env and fill in the passwords (never commit .env, NFR-08). Variables: design/01 §1.7.3.
# scripts/setup-databases.ps1 and scripts/setup-mosquitto.ps1 write the database and MQTT lines for you.

# Database (all backend processes)
DATABASE_URL=postgresql://ews:change-me@localhost:5432/ews
# Demo mode only: separate database marked ews.is_demo = on (design/11 §11.3.1)
DEMO_DATABASE_URL=postgresql://ews:change-me@localhost:5432/ews_demo

# MQTT (ingest)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_INGEST_USER=ingest
MQTT_INGEST_PASSWORD=change-me

# Email (mailer); defaults point to Mailpit (tools/mailpit.exe)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ews@localhost
SMTP_TLS=false

# Links in emails and the allowed WebSocket origin (design/02 §2.2.1)
APP_BASE_URL=http://localhost:8000
# Extra WebSocket origins; empty except with start.ps1 -Dev (DD122)
DEV_ORIGINS=

# Session tokens: a long random string
SECRET_KEY=change-me-to-a-long-random-string

# Open-Meteo (worker)
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive

# Folders and logging (all processes)
MODELS_DIR=models
LOG_DIR=logs
LOG_LEVEL=INFO

# real (default) or demo: demo follows the simulator's clock (design/11 §11.3)
EWS_CLOCK=real
